<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Every partner shipping this SDK inherits these declarations into their own App Store
    privacy disclosure, so an omission here becomes their problem, not ours. When in doubt
    we over-declare: a partner's page reading one extra data type costs them nothing,
    while an undeclared type is an App Review rejection with their name on it.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!--
            Precise and Coarse are both declared even though the destination coordinates
            come from the host app and the user's own position is only ever inferred
            server-side from their IP address, which is city-level at best. Coarse alone
            would arguably be truthful. Kept as-is on purpose: the two candidates for
            "precise" are Cloudflare's IP latitude, which carries decimals, and the
            destinationLat/destinationLng the SDK sends, and neither is worth a rejection
            to argue. Do not narrow this without a reviewer's ruling in writing.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePreciseLocation</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCoarseLocation</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!--
            The SDK's `sid22`. The server assigns it in the partner-config response, we
            store it in UserDefaults (LocalStore, key `session_id`), and it rides every
            later request and every outgoing link. Nothing ever clears it, so it survives
            app restarts and is device-scoped and permanent in practice — which is Apple's
            Device ID, not a session token, whatever our own name for it suggests.
            Analytics is a real purpose and not padding: `loads`, `impression` and
            `fail_pn` are keyed by it in Mixpanel.
            Linked is false and that is UNDER REVIEW, not settled. The reasoning that
            put it there, "no account or login, so there is no identity to link to",
            does not survive Apple's own wording, which counts linkage "via the user's
            account, device, or other details". Our backend sends this same identifier as
            Mixpanel's `distinct_id`, which is the analytics identity, alongside `ip`,
            `userCity`, `userLatLng` and `userTimezone`
            (monoco apps/frontend/src/server/routes/partner/index.ts, `trackProps`).
            On that evidence Linked=true is the defensible answer.
            Not flipped here on an engineer's judgement: the value is inherited into every
            partner's own App Store privacy answers, and 1.2.0 already shipped with false,
            so changing it is a legal and product call rather than a code fix. Raised for
            that decision; do not "tidy" this comment away without one.
        -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
